@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма (C1). Основное решение: распределённая архитектура с обработкой на границе сети

' === Пользователи ===
Person(оператор, "Оператор фермы", "Получает оповещения о нештатных ситуациях, управляет системой на месте")
Person(зоотехник, "Зоотехник", "Контролирует кормление, пересчёт поголовья, запасы корма")
Person(ветеринар, "Ветеринар", "Получает оповещения о болезнях и гибели животных")
Person(администратор, "Администратор системы", "Управляет учётными записями, ролями и настройками платформы")

' === Новая система: MVP платформа мониторинга скота ===
Enterprise_Boundary(mvp, "Платформа мониторинга скота (MVP)") {
    System(центральная_платформа, "Центральная платформа", "Агрегирует данные со всех ферм, предоставляет API для веб- и мобильных приложений, управляет учётными записями и ролями, хранит исторические данные, формирует аналитику")
    System(фермовый_агент, "Фермовый агент", "Локальный сервер на ферме с GPU/NPU. Выполняет ML-инференс на видеопотоке, управляет кормушками и поилками, отправляет оповещения дежурному при отсутствии связи, синхронизирует данные с центральной платформой")
}

' === IoT-устройства на ферме ===
Enterprise_Boundary(iot, "IoT-устройства на ферме") {
    System_Ext(камеры, "Видеокамеры", "Камеры разных производителей, включая ночную съёмку. Покрывают площадь фермы для видеоаналитики")
    System_Ext(кормушки, "Кормушки и поилки", "Устройства разных производителей для подачи корма и воды")
    System_Ext(датчики_воды, "Системы фильтрации воды", "Датчики состояния фильтров и качества воды")
}

' === Существующие системы компании ===
Enterprise_Boundary(existing, "Существующие системы АгроТех Х") {
    System_Ext(erp, "ERP (1С:Агро)", "Финансы, складской учёт, кадры")
    System_Ext(kafka, "Брокер сообщений (Apache Kafka)", "Существующая шина данных компании")
    System_Ext(веб_портал, "Веб-портал (React)", "Существующий портал управления хозяйством")
    System_Ext(мобильное_приложение, "Мобильное приложение (Flutter)", "Существующее приложение для полевых работ")
    System_Ext(dwh, "Data Warehouse (ClickHouse)", "Существующее хранилище структурированных данных")
    System_Ext(bi, "BI система (Power BI)", "Существующая система отчётности")
}

' === Внешние поставщики ===
System_Ext(ml_модель, "ML-модель от партнёров", "Готовая нейросетевая модель для распознавания поведения и состояния животных")

' === Связи пользователей ===
Rel(оператор, веб_портал, "Мониторинг и управление")
Rel(оператор, мобильное_приложение, "Получает оповещения")
Rel(зоотехник, веб_портал, "Просматривает данные о поголовье и кормлении")
Rel(зоотехник, мобильное_приложение, "Получает оповещения о запасах корма")
Rel(ветеринар, мобильное_приложение, "Получает оповещения о состоянии животных")
Rel(администратор, центральная_платформа, "Управляет настройками и ролями")

' === Связи центральной платформы ===
Rel(центральная_платформа, kafka, "Публикует и получает события", "Kafka Protocol")
Rel(центральная_платформа, erp, "Обменивается данными о поголовье и расходах", "REST API")
Rel(центральная_платформа, dwh, "Сохраняет агрегированные данные", "SQL")
Rel(центральная_платформа, веб_портал, "Предоставляет API", "REST/WebSocket")
Rel(центральная_платформа, мобильное_приложение, "Предоставляет API и push-уведомления", "REST/WebSocket")
Rel(центральная_платформа, bi, "Передаёт метрики", "ODBC")

' === Связи фермового агента ===
Rel(фермовый_агент, центральная_платформа, "Синхронизирует данные (допустима задержка до 10 мин)", "REST API / Kafka")
Rel(фермовый_агент, камеры, "Получает видеопоток", "RTSP")
Rel(фермовый_агент, кормушки, "Управляет подачей корма и воды", "MQTT / Modbus")
Rel(фермовый_агент, датчики_воды, "Получает данные о состоянии фильтрации", "MQTT")
Rel(фермовый_агент, ml_модель, "Использует модель для инференса на видеопотоке")
Rel_L(фермовый_агент, оператор, "Оповещает дежурного при отсутствии связи", "SMS / локальная сеть")

@enduml
